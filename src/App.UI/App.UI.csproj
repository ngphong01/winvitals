<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\App.Storage\App.Storage.csproj" />
    <ProjectReference Include="..\App.Scanner\App.Scanner.csproj" />
    <ProjectReference Include="..\App.Cleaner\App.Cleaner.csproj" />
    <ProjectReference Include="..\App.Performance\App.Performance.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppUI</RootNamespace>
    <AssemblyName>WinHealth</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Authors>Đào Văn Phong</Authors>
    <Company>Đào Văn Phong</Company>
    <Version>2.0.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <Description>Windows Health Manager - Trình dọn dẹp thông minh cho developer và power user Việt Nam</Description>
    <Copyright>© 2025 Đào Văn Phong — MIT License</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\safe-clean.json">
      <Link>rules\safe-clean.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\deep-clean.json">
      <Link>rules\deep-clean.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\developer-clean.json">
      <Link>rules\developer-clean.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\rules\protected-paths.json">
      <Link>rules\protected-paths.json</Link>
    </EmbeddedResource>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
