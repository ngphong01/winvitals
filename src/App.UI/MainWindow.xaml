<Window x:Class="AppUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Health Manager — Đào Văn Phong"
        Icon="/Resources/app.ico"
        Height="820" Width="1260" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D1A"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>

        <!-- ===== COLOR SYSTEM ===== -->
        <SolidColorBrush x:Key="SidebarBg" Color="#0A0A16"/>
        <SolidColorBrush x:Key="MainBg" Color="#0D0D1A"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#111128"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#19193A"/>
        <SolidColorBrush x:Key="CardBg" Color="#12122A"/>
        <SolidColorBrush x:Key="CardBorder" Color="#25254A"/>
        <SolidColorBrush x:Key="Accent" Color="#6C8CF0"/>
        <SolidColorBrush x:Key="AccentLight" Color="#90A8F4"/>
        <SolidColorBrush x:Key="AccentDim" Color="#4C5CC0"/>
        <SolidColorBrush x:Key="Success" Color="#7ECF6A"/>
        <SolidColorBrush x:Key="SuccessDim" Color="#3D7A30"/>
        <SolidColorBrush x:Key="Warning" Color="#DDAF68"/>
        <SolidColorBrush x:Key="WarningDim" Color="#7A5A20"/>
        <SolidColorBrush x:Key="Danger" Color="#E76F80"/>
        <SolidColorBrush x:Key="DangerDim" Color="#7A3038"/>
        <SolidColorBrush x:Key="Info" Color="#6DCFEF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#DDE0F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#989AB8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5A5C80"/>
        <SolidColorBrush x:Key="NavHover" Color="#161840"/>
        <SolidColorBrush x:Key="NavActive" Color="#1E2060"/>
        <SolidColorBrush x:Key="OverlayBg" Color="#B00D0D1A"/>

        <!-- Gradients -->
        <LinearGradientBrush x:Key="GradientAccent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6C8CF0" Offset="0"/>
            <GradientStop Color="#A07CF0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradientSuccess" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7ECF6A" Offset="0"/>
            <GradientStop Color="#4DC8A0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradientWarning" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#DDAF68" Offset="0"/>
            <GradientStop Color="#E08050" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== NAV BUTTON ===== -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="0,8,8,0"
                                Margin="0,1,12,1">
                            <ContentPresenter VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource NavHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="22,18,0,6"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>

        <!-- ===== CARD STYLES ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="CardHover" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Background" Value="#18184A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardMetric" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== BUTTONS ===== -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="Foreground" Value="#0D0D1A"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
        </Style>

        <!-- ===== TYPOGRAPHY ===== -->
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,22,0,10"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- ===== INPUT CONTROLS ===== -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="12,0" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                <ToggleButton Grid.Column="1" Width="30" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <TextBlock Text="▼" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom" PopupAnimation="Fade">
                                    <Border Background="{StaticResource SurfaceBg}" CornerRadius="8"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="False" Padding="4">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== PAGE TRANSITION ANIMATIONS ===== -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                             Duration="0:0:0.25" AccelerationRatio="0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0"
                             Duration="0:0:0.12" AccelerationRatio="0.3"/>
        </Storyboard>
        <Storyboard x:Key="SlideUp">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.25"
                             AccelerationRatio="0.3" DecelerationRatio="0.1"/>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                             Duration="0:0:0.25"/>
        </Storyboard>

    </Window.Resources>

    <!-- ===== WINDOW FADE-IN ON LOAD ===== -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="ContentArea"
                                     Storyboard.TargetProperty="(UIElement.Opacity)"
                                     From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- ===== MAIN LAYOUT ===== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{StaticResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Border Grid.Row="0" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,0,0,1" Padding="20,18,20,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="{StaticResource GradientAccent}"
                                Margin="0,0,12,0">
                            <Image Source="/Resources/app.png" Width="28" Height="28"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="WinHealth" FontSize="16" FontWeight="Bold"
                                      Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="v2.0 — System Manager" FontSize="9.5"
                                      Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nav Items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="CHÍNH" Style="{StaticResource NavSection}"/>
                        <Button x:Name="BtnDashboard" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Dashboard">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="🏠  " FontSize="13"/><TextBlock Text="Bảng Điều Khiển"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnDisk" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Disk">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="📊  " FontSize="13"/><TextBlock Text="Phân Tích Ổ Đĩa"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnCleaner" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Cleaner">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="🧹  " FontSize="13"/><TextBlock Text="Dọn Dẹp"/></StackPanel></Button.Content>
                        </Button>

                        <TextBlock Text="CÔNG CỤ" Style="{StaticResource NavSection}"/>
                        <Button x:Name="BtnFileTools" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="FileTools">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="📁  " FontSize="13"/><TextBlock Text="Công Cụ File"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnDevTools" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="DevTools">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="⚙️  " FontSize="13"/><TextBlock Text="Dev Tools"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnPerf" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Performance">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="⚡  " FontSize="13"/><TextBlock Text="Hiệu Năng"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnQuarantine" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Quarantine">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="🛡  " FontSize="13"/><TextBlock Text="Cách Ly"/></StackPanel></Button.Content>
                        </Button>

                        <TextBlock Text="HỆ THỐNG" Style="{StaticResource NavSection}"/>
                        <Button x:Name="BtnAutoClean" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="AutoClean">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="🕐  " FontSize="13"/><TextBlock Text="Tự Động và Lịch"/></StackPanel></Button.Content>
                        </Button>
                        <Button x:Name="BtnSettings" Style="{StaticResource NavBtn}" Click="Nav_Click" Tag="Settings">
                            <Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="🔧  " FontSize="13"/><TextBlock Text="Cài Đặt &amp; Quy Tắc"/></StackPanel></Button.Content>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer -->
                <Border Grid.Row="2" Background="#060612" BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtSidebarStats" FontSize="10"
                                  Foreground="{StaticResource TextMuted}" LineHeight="16"
                                  TextWrapping="Wrap" Text="Sẵn sàng"/>
                        <TextBlock Text="v2.0 — Đào Văn Phong" FontSize="9"
                                  Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                                  Opacity="0.6"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource MainBg}"
                x:Name="ContentArea">
            <Grid>
                <!-- Dashboard View -->
                <ScrollViewer x:Name="DashboardView" Visibility="Visible"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32,28">
                        <!-- Header -->
                        <StackPanel Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Image Source="/Resources/app.png" Width="36" Height="36"
                                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bảng Điều Khiển" Style="{StaticResource PageTitle}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageSubtitle}"
                                      Text="Tổng quan hệ thống — sức khỏe, dung lượng và hoạt động gần đây"/>
                        </StackPanel>

                        <!-- Cleanup Potential Banner — gradient background, synced with health score -->
                        <Border x:Name="CleanupPotentialBanner" CornerRadius="12"
                                Padding="18,14" Margin="0,0,0,14" Cursor="Hand"
                                MouseLeftButtonDown="CleanupPotential_Click">
                            <Border.Background>
                                <LinearGradientBrush x:Name="BannerGradient" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="BannerGrad0" Color="#2A1E08" Offset="0"/>
                                    <GradientStop x:Name="BannerGrad1" Color="#3A2806" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="BannerBorderColor" Color="#DDAF68"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1.5</Border.BorderThickness>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CleanupPotentialBannerIcon" Grid.Column="0" CornerRadius="10" Width="44" Height="44"
                                        Background="#3A2A06" Margin="0,0,16,0">
                                    <TextBlock x:Name="CleanupPotentialBannerIconText" Text="⚡" FontSize="24"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCleanableEstimate" Text="Đang ước tính..."
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource Warning}"/>
                                    <TextBlock x:Name="TxtCleanableDetail"
                                               Text="Từ temp, cache, recycle bin, Windows Update..."
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="BtnSuaNgay"
                                        Content="✖  Sửa Ngay"
                                        Style="{StaticResource DangerBtn}"
                                        Width="120" Height="36"
                                        VerticalAlignment="Center"
                                        Click="OneClickFix_Click"/>
                            </Grid>
                        </Border>

                        <!-- Drive Usage Cards -->
                        <WrapPanel Margin="0,0,0,16">
                            <ItemsControl x:Name="DriveCards">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </WrapPanel>

                        <!-- Metric Cards Row -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Health Score — with donut ring -->
                            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="SỨC KHỎE HỆ THỐNG" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtScore" FontSize="36" FontWeight="Bold"
                                                       Foreground="{StaticResource Danger}"/>
                                            <TextBlock Text=" /100" FontSize="13" Margin="4,10,0,0"
                                                       Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtHealthLabel" Text="Kém" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,4,0,0"
                                                   Foreground="{StaticResource Danger}"/>
                                    </StackPanel>
                                    <!-- Circular ring indicator -->
                                    <Grid Grid.Column="1" Width="70" Height="70" Margin="8,0,0,0">
                                        <Ellipse Stroke="#2A2A50" StrokeThickness="8" Fill="Transparent"/>
                                        <Ellipse x:Name="HealthRingEllipse"
                                                 Stroke="#E08050" StrokeThickness="8" Fill="Transparent"
                                                 StrokeDashArray="220 220"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRingValue" Text="—" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource Warning}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Total Freed — with illustration emoji -->
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Margin="8,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="ĐÃ GIẢI PHÓNG" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtTotalFreed" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Tổng dung lượng đã dọn" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="🚢" FontSize="44"
                                               VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.85"/>
                                </Grid>
                            </Border>

                            <!-- Quarantine — with illustration emoji -->
                            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="ĐANG CÁCH LY" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="TxtQuarantinedDash" FontSize="26" FontWeight="Bold"
                                                   Foreground="{StaticResource Warning}" Margin="0,8,0,0"/>
                                        <TextBlock Text="Items trong quarantine" FontSize="11"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="☣" FontSize="30" Foreground="{StaticResource Warning}" Opacity="0.8"/>
                                        <TextBlock Text="🗑" FontSize="22" HorizontalAlignment="Center" Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Issues + Activity Grid -->
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Issues -->
                            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="18" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="⚠  CẢNH BÁO QUAN TRỌNG" FontSize="12" FontWeight="Bold"
                                              Foreground="{StaticResource Warning}"/>
                                    <ItemsControl x:Name="IssuesList" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Activity -->
                            <Border Grid.Column="1" Style="{StaticResource GlassCard}" Padding="18" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text=" HOẠT ĐỘNG GẦN ĐÂY" FontSize="12" FontWeight="Bold"
                                              Foreground="{StaticResource Accent}"/>
                                    <ItemsControl x:Name="RecentList" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="  Quét Toàn Bộ" Style="{StaticResource PrimaryBtn}"
                                    Width="150" Margin="0,0,10,0" Click="FullScan_Click"/>
                            <Button Content="  Dọn Nhanh" Style="{StaticResource SuccessBtn}"
                                    Width="130" Margin="0,0,10,0" Click="QuickClean_Click"/>
                            <Button Content="  Kiểm Tra Hiệu Năng" Style="{StaticResource SecondaryBtn}"
                                    Width="160" Click="PerfCheck_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sub Pages View -->
                <ScrollViewer x:Name="PageView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PagePanel" Margin="32,28"/>
                </ScrollViewer>

                <!-- Loading Overlay with animated spinner -->
                <Border x:Name="LoadingOverlay" Background="{StaticResource OverlayBg}"
                        Visibility="Collapsed" Panel.ZIndex="100">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Ellipse Width="44" Height="44" Stroke="{StaticResource Accent}"
                                     StrokeThickness="3" Margin="0,0,0,18"
                                     HorizontalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotate"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                               From="0" To="360" Duration="0:0:1"
                                                               RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="TxtLoading" Text="Đang xử lý..."
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="{StaticResource TextSecondary}"
                                      HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="ScanProgress" Width="280" Height="3"
                                        Foreground="{StaticResource Accent}"
                                        Background="{StaticResource SurfaceBg}"
                                        BorderThickness="0" IsIndeterminate="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock x:Name="StatusCpu" Text="CPU —%" FontSize="11"
                              Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusRam" Text="RAM —%" FontSize="11"
                              Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="StatusDisk" Text="Disk —%" FontSize="11"
                              Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="© 2025 Đào Văn Phong" FontSize="11"
                              Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"
                              Opacity="0.5"/>
                    <TextBlock x:Name="StatusVersion" Text="v2.0.0" FontSize="11"
                              Foreground="{StaticResource TextMuted}" Opacity="0.5"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
