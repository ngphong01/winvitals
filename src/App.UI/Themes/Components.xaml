<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== SKELETON LOADING / SHIMMER ===== -->
    <Style x:Key="SkeletonBox" TargetType="Border">
        <Setter Property="Background" Value="#1A1A3A"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SkeletonCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="#12122A"/>
        <Setter Property="Height" Value="80"/>
        <Setter Property="Padding" Value="14"/>
    </Style>
    <Style x:Key="SkeletonCircle" TargetType="Ellipse">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Fill" Value="#1A1A3A"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <!-- ===== EMPTY STATE ===== -->
    <Style x:Key="EmptyState" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#5A5C80"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,24,0,0"/>
    </Style>

    <!-- ===== BADGE STYLES ===== -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2,6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BadgeSafe" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#1A3428"/>
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#342820"/>
    </Style>
    <Style x:Key="BadgeDanger" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="#341820"/>
    </Style>

    <!-- ===== STAT ROW (consistent label + value) ===== -->
    <Style x:Key="StatRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#5A5C80"/>
        <Setter Property="Width" Value="80"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#DDE0F5"/>
    </Style>

    <!-- ===== DIVIDER ===== -->
    <Style x:Key="Divider" TargetType="Separator">
        <Setter Property="Background" Value="#25254A"/>
        <Setter Property="Margin" Value="0,8"/>
        <Setter Property="Height" Value="1"/>
    </Style>
</ResourceDictionary>
